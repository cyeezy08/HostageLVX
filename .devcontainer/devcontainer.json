// .devcontainer/devcontainer.json
// Codespace config — one-click Go dev env with hostage deps baked in.
// "Open in Codespaces" button on the README uses this.
{
  "name": "hostage-dev",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": false,
      "username": "vscode",
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "go mod download && go build -o /usr/local/bin/hostage . && hostage -fingerprints | head -5",
  "forwardPorts": [],
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "GitHub.copilot",
        "eamodio.gitlens"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "go.lintOnSave": "workspace",
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },
  "remoteEnv": {
    "HOSTAGE_VERSION": "dev"
  }
}
